{
  "name": "@bongofleet/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "BongoFleet fleet-owner web dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "preview": "vite preview",
    "test": "echo \"no unit tests yet - see pnpm test:e2e for the Playwright smoke suite\" && exit 0",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@bongofleet/shared-lib": "workspace:*",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.5"
  }
