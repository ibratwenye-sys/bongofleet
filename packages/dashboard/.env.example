# Copy to .env if you need to point at a non-default backend URL.
# Defaults to http://localhost:3000 if unset.
VITE_API_URL=http://localhost:3000

# Stage I3 (DESIGN_GPS_TRACKING.md §7/§8) - a MapTiler Cloud API key, needed
# to render map tiles on the live tracking page and the public tracking-link
# page. Get one at https://cloud.maptiler.com/account/keys/. Left unset here
# on purpose - no key existed when this stage shipped. Without it, both
# pages still work (markers, side panel, date picker) but show a plain
# background with a banner instead of map tiles.
VITE_MAPTILER_KEY=
