{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    // Stage H1 - matches vite.config.mts's resolve.alias: without this, tsc
    // resolves @bongofleet/shared-lib via its package.json "main"
    // (dist/index.d.ts) while Vite compiles the source directly, so the
    // typechecker and the bundler would silently disagree about what the
    // package exports - the same staleness bug in a different guise.
    "baseUrl": ".",
    "paths": {
      "@bongofleet/shared-lib": ["../shared-lib/src/index.ts"]
    }
  },
  "include": ["src"]
}
