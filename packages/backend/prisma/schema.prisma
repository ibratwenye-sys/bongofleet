generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  RIDER
  MECHANIC

  @@map("user_role")
}

/// Stage UI1 (DESIGN_THEMING.md) - the dashboard's dark/light choice.
/// Belongs on the account, not browser storage, so it's the same across
/// devices. Nullable rather than defaulted to DARK: null means "never
/// chosen" and the client falls back to dark (the deliberate default,
/// never guessed from OS preference) - an explicit DARK row would be
/// indistinguishable from that same fallback, so there is nothing to gain
/// from a non-null default here.
enum Theme {
  DARK
  LIGHT

  @@map("theme")
}

/// Stage S1. Where a tenant sits in the signup/billing lifecycle - checked
/// on every authenticated request via tenant-lock.util.ts's checkTenantLock,
/// which is the one place this enum's meaning is actually decided.
enum TenantStatus {
  /// Just signed up, has not yet proved control of the owner's email. Locked
  /// unconditionally - see checkTenantLock - regardless of any other field.
  PENDING_VERIFICATION
  /// Verified. Still locked if trialEndsAt has passed - see checkTenantLock -
  /// there is no separate "trialing" status; the trial is a clock on this
  /// status, not a status of its own.
  ACTIVE
  /// Reserved for a future billing integration to set on a failed charge.
  /// Nothing in this stage ever sets it - the enum value exists now so the
  /// lock predicate and its tests are already correct on the day something
  /// does.
  PAST_DUE
  CANCELLED

  @@map("tenant_status")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("payment_status")
}

enum VehicleType {
  MOTORBIKE
  BAJAJI
  CAR
  TRUCK
}

/// Which vehicles a driver may be assigned. RIDER covers motorbike + bajaji
/// (the daily-deposit rental fleet); CAR_DRIVER and TRUCK_DRIVER cover the
/// transport-job fleet. Enforced in the service layer, not just here.
enum DriverType {
  RIDER
  CAR_DRIVER
  TRUCK_DRIVER

  @@map("driver_type")
}

enum MotorcycleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED

  @@map("motorcycle_status")
}

/// Stage I1 (DESIGN_GPS_TRACKING.md §2). Where a GpsLocation fix came from.
/// DEVICE and MANUAL exist now so GpsLocation's shape is settled in one
/// migration - only PHONE is actually written until the box-ingestion stage.
enum GpsSource {
  PHONE
  DEVICE
  MANUAL

  @@map("gps_source")
}

/// Stage I1 - which of the two reporting paths a vehicle uses. DEVICE/BOTH
/// are unused until POST /gps/device (a later stage, depends on confirming
/// Traccar Cloud's webhook payload shape first) - added now, alongside
/// Motorcycle.gpsDeviceSecretHash below, so that stage needs no second
/// migration. PHONE is the default: every vehicle is phone-tracked (via its
/// assigned rider's phone) until an owner fits a box.
enum TrackingMode {
  NONE
  PHONE
  DEVICE
  BOTH

  @@map("tracking_mode")
}

enum DocumentOwnerType {
  RIDER
  MOTORCYCLE
  GUARANTOR
  OWNERSHIP_PLAN

  @@map("document_owner_type")
}

enum DocumentType {
  NATIONAL_ID
  DRIVERS_LICENSE
  LATRA
  INSURANCE
  REGISTRATION_CARD
  GUARANTOR_ID
  VEHICLE_INSPECTION
  ROAD_SAFETY_WEEK
  TBS_CERTIFICATE
  HIRE_PURCHASE_CONTRACT
  OTHER

  @@map("document_type")
}

enum DocumentAlertKind {
  EXPIRING_SOON
  EXPIRED

  @@map("document_alert_kind")
}

enum PaymentAlertKind {
  NO_PAYMENT
  SHORTFALL

  @@map("payment_alert_kind")
}

enum MaintenanceReminderKind {
  DUE_SOON
  OVERDUE

  @@map("maintenance_reminder_kind")
}

/// A fleet-owning company/account. Root of multi-tenancy - every other table
/// scopes its data to a tenantId.
model Tenant {
  id              String  @id @default(cuid())
  name            String
  contactEmail    String? @map("contact_email")
  contactPhone    String? @map("contact_phone")
  /// Company party block on the hire-purchase contract (§Part 1). No API
  /// currently sets these - there is no Tenant CRUD surface in this codebase
  /// yet - so they render "Haijajazwa / Not on file" until one exists.
  physicalAddress String? @map("physical_address")
  directorName    String? @map("director_name")
  isActive        Boolean @default(true) @map("is_active")

  /// Stage S1 - see TenantStatus. Independent of isActive above: isActive is
  /// the existing, separate switch the notification cron jobs already filter
  /// on (document-expiry-notification.service.ts and friends); this is
  /// specifically whether the tenant's OWN USERS can use the product. A
  /// PAST_DUE tenant should keep receiving its own missed-payment reminders,
  /// for instance - isActive and status are deliberately never made to imply
  /// each other.
  status TenantStatus @default(PENDING_VERIFICATION)

  /// Stamped once, when verification succeeds. Never cleared.
  verifiedAt DateTime? @map("verified_at")

  /// Stage S1 Part 2 - set at VERIFICATION, not at signup. An owner who
  /// opens his email the next morning must not have already burned a third
  /// of a 7-day trial on nothing. Null until then; null also for every
  /// tenant grandfathered ACTIVE by this migration, which is what "no trial
  /// clock running" means for an account that predates trials entirely.
  trialEndsAt DateTime? @map("trial_ends_at")

  /// Stage S1 Part 3 - overrides every other field in checkTenantLock,
  /// unconditionally: an exempt tenant is never locked, whatever its status
  /// or dates say. Ibrahim's own fleet is set exempt in this migration - his
  /// own product must never lock him out of it or bill him.
  billingExemptAt DateTime? @map("billing_exempt_at")

  /// Stage I1 (DESIGN_GPS_TRACKING.md §4/§10). Working-hours window for GPS
  /// reporting - nullable, BOTH unset by default. NOT enforced anywhere yet:
  /// §10's working-hours question is still genuinely undecided, not just
  /// unbuilt. POST /gps/phone must accept every fix regardless of hour while
  /// these are null, which is every tenant right now. Added now purely so
  /// the schema doesn't need a second migration once that decision lands.
  trackingStartHour Int? @map("tracking_start_hour")
  trackingEndHour   Int? @map("tracking_end_hour")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                User[]
  drivers              Driver[]
  motorcycles          Motorcycle[]
  dailyAssignments     DailyAssignment[]
  dailyPayments        DailyPayment[]
  gpsLocations         GpsLocation[]
  maintenanceLogs      MaintenanceLog[]
  expenses             Expense[]
  guarantors           Guarantor[]
  documents            Document[]
  documentAlerts       DocumentAlert[]
  assignmentAlerts     AssignmentAlert[]
  maintenanceReminders MaintenanceReminder[]
  transportJobs        TransportJob[]
  paymentAccounts      PaymentAccount[]
  dayExcusals          DayExcusal[]
  trackingLinks        TrackingLink[]

  @@map("tenants")
}

/// Anyone who logs in: owner, manager, driver, or mechanic. Drivers get an
/// additional Driver profile (1:1) holding driver-specific fields.
model User {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  phone        String
  passwordHash String   @map("password_hash")
  role         UserRole
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  // Stage UI1 - see the Theme enum's own comment. Every role (OWNER/
  // MANAGER/RIDER/MECHANIC) has a User row, so this lives here rather than
  // on Driver - a fleet owner's own theme choice has nowhere else to go.
  theme        Theme?

  /// When this address was last PROVEN to reach the person who owns the
  /// account - set only when they complete a self-service password reset
  /// using a code sent to it. Receiving the code and using it is delivery
  /// and possession in a single act, which is why this is set there and
  /// nowhere else.
  ///
  /// Deliberately not called emailVerifiedAt: there is no verification flow
  /// here, nothing is sent at signup, and a null means "never demonstrated",
  /// not "failed a check". Most rows will be null forever and that is not a
  /// fault - it is the honest state, and the point of recording it is that
  /// an owner can see which riders can actually recover on their own.
  emailProvenAt DateTime? @map("email_proven_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driverProfile            Driver?
  maintenanceLogsPerformed MaintenanceLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("users")
}

/// Driver-specific profile, 1:1 with a User whose role is RIDER.
/// Soft-deleted (isActive/deletedAt) rather than hard-deleted so that
/// DailyAssignment/DailyPayment history stays intact.
model Driver {
  id                String     @id @default(cuid())
  tenantId          String     @map("tenant_id")
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  userId            String     @unique @map("user_id")
  user              User       @relation(fields: [userId], references: [id])
  licenseNumber     String     @map("license_number")
  driverType        DriverType @default(RIDER) @map("driver_type")
  nationalId        String?    @map("national_id")
  emergencyContact  String?    @map("emergency_contact")
  /// The residence the hire-purchase contract identifies the driver by.
  residenceWard     String?    @map("residence_ward")
  residenceDistrict String?    @map("residence_district")
  residenceRegion   String?    @map("residence_region")
  isActive          Boolean    @default(true) @map("is_active")
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  dailyAssignments DailyAssignment[]
  dailyPayments    DailyPayment[]
  guarantors       Guarantor[]
  transportJobs    TransportJob[]

  @@unique([tenantId, licenseNumber])
  @@index([tenantId])
  @@map("riders")
}

/// A driver's named guarantor (a person who vouches for them), e.g. for a
/// bike-financing arrangement. A driver can have any number of guarantors -
/// no minimum is enforced here (the UI will encourage at least two).
model Guarantor {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  driverId          String    @map("rider_id")
  driver            Driver    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  phone             String
  relationship      String?
  nationalId        String?   @map("national_id")
  /// The next-of-kin residence printed on the hire-purchase contract (§Part 1).
  residenceWard     String?   @map("residence_ward")
  residenceDistrict String?   @map("residence_district")
  residenceRegion   String?   @map("residence_region")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([driverId])
  @@map("guarantors")
}

/// An uploaded document (ID, license, insurance, etc.) belonging to a driver,
/// motorcycle, or guarantor. Polymorphic by ownerType/ownerId rather than a
/// Prisma relation, since it can point at three different tables. File bytes
/// live on disk (see UPLOADS_DIR); only metadata + the storage path live here.
model Document {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  ownerType       DocumentOwnerType @map("owner_type")
  ownerId         String            @map("owner_id")
  docType         DocumentType      @map("doc_type")
  referenceNumber String?           @map("reference_number")
  expiryDate      DateTime?         @map("expiry_date") @db.Date
  fileName        String            @map("file_name")
  mimeType        String            @map("mime_type")
  storageKey      String            @map("storage_key")
  sizeBytes       Int               @map("size_bytes")
  uploadedAt      DateTime          @map("uploaded_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  alerts DocumentAlert[]

  @@index([tenantId])
  @@index([ownerType, ownerId])
  @@index([tenantId, expiryDate])
  @@map("documents")
}

/// A record that an expiry alert email has already been sent for a document,
/// so the daily scan never notifies the owner twice about the same thing.
/// One row per (document, kind): a document can alert once as EXPIRING_SOON
/// and once again as EXPIRED. Rows cascade-delete with their document, so a
/// replaced (re-uploaded) document alerts afresh on its new expiry date.
model DocumentAlert {
  id         String            @id @default(cuid())
  tenantId   String            @map("tenant_id")
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  documentId String            @map("document_id")
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind       DocumentAlertKind
  sentTo     String            @map("sent_to")
  sentAt     DateTime          @default(now()) @map("sent_at")

  @@unique([documentId, kind])
  @@index([tenantId])
  @@map("document_alerts")
}

/// A fleet motorcycle. Soft-deleted (isActive/deletedAt) rather than hard
/// deleted so MaintenanceLog/Expense/GpsLocation/DailyAssignment history
/// stays intact - relations below use onDelete: Restrict to enforce that
/// at the DB level too.
model Motorcycle {
  id                 String           @id @default(cuid())
  tenantId           String           @map("tenant_id")
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  registrationNumber String           @map("registration_number")
  vehicleType        VehicleType      @default(MOTORBIKE) @map("vehicle_type")
  make               String?
  model              String?
  year               Int?
  /// The recital on the hire-purchase contract identifies the vehicle by
  /// these two - not stored anywhere else on this model until now (§Part 1).
  chassisNumber      String?          @map("chassis_number")
  colour             String?
  // Stage UI2 - free text the owner types by hand per vehicle ("Kariakoo",
  // "Kinondoni"). No geofencing, no polygon math, no derivation from GPS -
  // there is no named-area data anywhere else in this schema to compute it
  // from. The Fleet page's area panel groups vehicles by this field,
  // honestly labelled as owner-set rather than computed.
  operatingArea      String?          @map("operating_area")
  gpsDeviceId        String?          @map("gps_device_id")
  // Stage I1 - PHONE default: every vehicle is tracked via its assigned
  // rider's phone (POST /gps/phone) until an owner sets up a box.
  // gpsDeviceSecretHash is unused until the box-ingestion stage (POST
  // /gps/device) - never a plaintext secret, same convention as
  // User.passwordHash.
  trackingMode        TrackingMode     @default(PHONE) @map("tracking_mode")
  gpsDeviceSecretHash String?          @map("gps_device_secret_hash")
  status             MotorcycleStatus @default(ACTIVE)
  currentMileage     Int              @default(0) @map("current_mileage")
  isActive           Boolean          @default(true) @map("is_active")
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  dailyAssignments DailyAssignment[]
  gpsLocations     GpsLocation[]
  maintenanceLogs  MaintenanceLog[]
  expenses         Expense[]
  transportJobs    TransportJob[]
  trackingLinks    TrackingLink[]

  @@unique([tenantId, registrationNumber])
  @@unique([tenantId, gpsDeviceId])
  @@index([tenantId])
  @@map("motorcycles")
}

/// One driver assigned to one motorcycle for one calendar date. A motorcycle
/// can only be assigned to one driver per day, and vice versa (see the two
/// @@unique constraints below).
model DailyAssignment {
  id                       String     @id @default(cuid())
  tenantId                 String     @map("tenant_id")
  tenant                   Tenant     @relation(fields: [tenantId], references: [id])
  driverId                 String     @map("rider_id")
  driver                   Driver     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  motorcycleId             String     @map("motorcycle_id")
  motorcycle               Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  assignedDate             DateTime   @map("assigned_date") @db.Date
  targetAmount             Decimal    @map("target_amount") @db.Decimal(10, 2)
  notes                    String?
  /// Permanent, never-repeating ride number (e.g. BF-7K3M9QP2) assigned when
  /// the ride is registered. All of this ride's deposits/receipts quote it, so
  /// a bank statement or mobile-money callback reconciles back to this ride.
  reference                String?    @unique
  /// Set together, only when an OWNER overrides a driver-category/vehicle-type
  /// mismatch at creation. Null on every ordinary (compatible) assignment.
  categoryOverrideReason   String?    @map("category_override_reason")
  categoryOverrideByUserId String?    @map("category_override_by_user_id")
  categoryOverrideAt       DateTime?  @map("category_override_at")
  /// Non-null => generated by the hire-purchase nightly generator (a later
  /// stage). Plain scalar, not a Prisma relation - see OwnershipPlan's own
  /// comment. A plan assignment is otherwise ordinary: payments, revenue
  /// queries and the missed-payment notification all work against it unchanged.
  ownershipPlanId          String?    @map("ownership_plan_id")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  dailyPayments DailyPayment[]
  alert         AssignmentAlert?

  @@unique([tenantId, motorcycleId, assignedDate])
  @@unique([tenantId, driverId, assignedDate])
  @@index([tenantId])
  @@map("daily_assignments")
}

/// A driver's remittance towards a DailyAssignment's targetAmount. One
/// assignment can have multiple payment rows (e.g. a FAILED attempt
/// followed by a successful retry), so this is many-to-one, not 1:1.
model DailyPayment {
  id                String          @id @default(cuid())
  tenantId          String          @map("tenant_id")
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  dailyAssignmentId String          @map("daily_assignment_id")
  dailyAssignment   DailyAssignment @relation(fields: [dailyAssignmentId], references: [id], onDelete: Restrict)
  driverId          String          @map("rider_id")
  driver            Driver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  amount            Decimal         @db.Decimal(10, 2)
  status            PaymentStatus   @default(PENDING)
  paymentMethod     String?         @map("payment_method")
  /// Which of the tenant's configured accounts this payment was made into.
  /// Deliberately separate from paymentMethod (free text, unconstrained,
  /// historical rows keep meaning exactly what they meant) - this is the new,
  /// optional, structured pointer sitting beside it, never replacing it.
  paymentAccountId  String?         @map("payment_account_id")
  paymentAccount    PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  receiptStorageKey String?         @map("receipt_storage_key")
  receiptFileName   String?         @map("receipt_file_name")
  receiptMimeType   String?         @map("receipt_mime_type")
  receiptSizeBytes  Int?            @map("receipt_size_bytes")
  receiptUploadedAt DateTime?       @map("receipt_uploaded_at")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([dailyAssignmentId])
  @@index([paymentAccountId])
  @@map("daily_payments")
}

/// A record that a missed/short payment alert email has been sent for a
/// daily assignment, so the daily scan never nags the owner twice about the
/// same day. One alert ever per assignment (unique dailyAssignmentId): once
/// the owner has been told a day came up short, further chasing happens in
/// the dashboard, not their inbox. Cascade-deletes with its assignment.
model AssignmentAlert {
  id                String           @id @default(cuid())
  tenantId          String           @map("tenant_id")
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  dailyAssignmentId String           @unique @map("daily_assignment_id")
  dailyAssignment   DailyAssignment  @relation(fields: [dailyAssignmentId], references: [id], onDelete: Cascade)
  kind              PaymentAlertKind
  targetAmount      Decimal          @map("target_amount") @db.Decimal(10, 2)
  paidAmount        Decimal          @map("paid_amount") @db.Decimal(10, 2)
  sentTo            String           @map("sent_to")
  sentAt            DateTime         @default(now()) @map("sent_at")

  @@index([tenantId])
  @@map("assignment_alerts")
}

/// Append-only GPS ping log for live tracking. No partitioning/retention
/// logic yet (MVP scope) - just indexed for the obvious query pattern
/// (a motorcycle's pings over a time range).
model GpsLocation {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  motorcycleId String     @map("motorcycle_id")
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  // Stage I1 (§2/§4). Which reporting path this fix came from - only PHONE
  // is written until box ingestion. driverId is the rider whose phone
  // reported it (resolved server-side from their own DailyAssignment - see
  // GpsService - never taken from the request body); null for DEVICE/MANUAL,
  // which have no phone in the loop. Plain scalar, not a Prisma relation -
  // same convention as OwnershipPlan.driverId (no FK needed for a fix log).
  source         GpsSource @default(PHONE) @map("source")
  driverId       String?   @map("rider_id")
  latitude       Float
  longitude      Float
  speedKmh       Float?    @map("speed_kmh")
  heading        Float?
  accuracyMeters Float?    @map("accuracy_meters")
  batteryPercent Int?      @map("battery_percent")
  recordedAt     DateTime  @map("recorded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([motorcycleId, recordedAt])
  @@index([tenantId, recordedAt])
  @@index([tenantId, motorcycleId, source, recordedAt])
  @@map("gps_locations")
}

model MaintenanceLog {
  id                 String     @id @default(cuid())
  tenantId           String     @map("tenant_id")
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  motorcycleId       String     @map("motorcycle_id")
  motorcycle         Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  mechanicId         String?    @map("mechanic_id")
  mechanic           User?      @relation(fields: [mechanicId], references: [id])
  description        String
  cost               Decimal    @db.Decimal(10, 2)
  performedAt        DateTime   @map("performed_at") @db.Date
  mileageAtService   Int?       @map("mileage_at_service")
  nextServiceDate    DateTime?  @map("next_service_date") @db.Date
  nextServiceMileage Int?       @map("next_service_mileage")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  reminders MaintenanceReminder[]

  @@index([tenantId])
  @@index([motorcycleId])
  @@map("maintenance_logs")
}

/// Records that a service-due reminder email has been sent for a maintenance
/// log's next-service target, so the daily scan never nags the owner twice for
/// the same target. One row per (maintenanceLog, kind): a target can remind
/// once as DUE_SOON and once more as OVERDUE. Logging a new service creates a
/// new maintenance log (a new target), which reminds afresh. Cascade-deletes
/// with its maintenance log.
model MaintenanceReminder {
  id               String                  @id @default(cuid())
  tenantId         String                  @map("tenant_id")
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  maintenanceLogId String                  @map("maintenance_log_id")
  maintenanceLog   MaintenanceLog          @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)
  kind             MaintenanceReminderKind
  sentTo           String                  @map("sent_to")
  sentAt           DateTime                @default(now()) @map("sent_at")

  @@unique([maintenanceLogId, kind])
  @@index([tenantId])
  @@map("maintenance_reminders")
}

/// Fleet expense, optionally tied to a specific motorcycle (fuel, repair)
/// or tenant-wide (e.g. office rent) when motorcycleId is null.
model Expense {
  id                 String        @id @default(cuid())
  tenantId           String        @map("tenant_id")
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  motorcycleId       String?       @map("motorcycle_id")
  motorcycle         Motorcycle?   @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  /// When set, this expense is attributed to a transport job for per-job P&L.
  /// Job expenses also carry motorcycleId (the job's vehicle) for per-vehicle rollups.
  transportJobId     String?       @map("transport_job_id")
  transportJob       TransportJob? @relation(fields: [transportJobId], references: [id], onDelete: SetNull)
  category           String
  amount             Decimal       @db.Decimal(10, 2)
  incurredAt         DateTime      @map("incurred_at") @db.Date
  description        String?
  /// Stage H1 (DESIGN_RIDER_EXPENSES.md). @default(APPROVED), not PENDING:
  /// an OWNER/MANAGER creating an expense on the dashboard today IS the
  /// approver, and every row that exists before this migration must keep
  /// counting exactly as it always has - zero backfill. Only the H2
  /// rider-submission endpoint will ever explicitly write PENDING.
  status             ExpenseStatus @default(APPROVED)
  /// Stage H1 - who submitted this expense, and through what channel. A
  /// dashboard-created expense has submittedByUserId (the OWNER/MANAGER) and
  /// no submittedByRiderId; a rider-submitted one (H2) has the reverse. Both
  /// null is not expected once H2 ships, but is exactly every row that
  /// exists before it - so neither is required now. Plain scalars, no
  /// Prisma relation, matching TransportJob.categoryOverrideByUserId's
  /// existing audit-trail-field convention.
  submittedByUserId  String?       @map("submitted_by_user_id")
  submittedByRiderId String?       @map("submitted_by_rider_id")
  /// Stage H1 - which of the rider's DailyAssignment days this expense
  /// belongs to, for a rider-submitted expense (H2). Null for every
  /// dashboard-created expense, exactly like motorcycleId/transportJobId are
  /// null for the kinds of expenses that don't apply to.
  dailyAssignmentId  String?       @map("daily_assignment_id")
  approvedByUserId   String?       @map("approved_by_user_id")
  approvedAt         DateTime?     @map("approved_at")
  rejectionReason    String?       @map("rejection_reason")
  /// Mirrors DailyPayment's receipt columns exactly (same names, same
  /// types) - applying that existing pattern to a second model, not
  /// inventing a new one. Upload endpoint is H2/H4; these are just columns
  /// for now.
  receiptStorageKey  String?       @map("receipt_storage_key")
  receiptFileName    String?       @map("receipt_file_name")
  receiptMimeType    String?       @map("receipt_mime_type")
  receiptSizeBytes   Int?          @map("receipt_size_bytes")
  receiptUploadedAt  DateTime?     @map("receipt_uploaded_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([transportJobId])
  @@map("expenses")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("expense_status")
}

enum TransportJobStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// A car/truck transport job: move goods or a vehicle from origin to
/// destination for an agreed revenue. Expenses tag onto it for per-job and
/// per-vehicle profit/loss (the cost-benefit view). Rental vehicles
/// (motorbike/bajaji) use DailyAssignment instead.
model TransportJob {
  id                       String             @id @default(cuid())
  tenantId                 String             @map("tenant_id")
  tenant                   Tenant             @relation(fields: [tenantId], references: [id])
  motorcycleId             String             @map("motorcycle_id")
  motorcycle               Motorcycle         @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)
  driverId                 String?            @map("rider_id")
  driver                   Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  ownerDriven              Boolean            @default(false) @map("owner_driven")
  reference                String?            @unique
  origin                   String
  destination              String
  cargo                    String?
  revenue                  Decimal            @db.Decimal(12, 2)
  // Stage DM12 - what the job pays the driver, separate from the owner's
  // revenue above. Nullable: most jobs today don't record it.
  driverFee                Decimal?           @map("driver_fee") @db.Decimal(12, 2)
  status                   TransportJobStatus @default(SCHEDULED)
  scheduledDate            DateTime           @map("scheduled_date") @db.Date
  pickedUpAt               DateTime?          @map("picked_up_at")
  deliveredAt              DateTime?          @map("delivered_at")
  // Stage UI2 - optional, set at job creation (revisable up to completion).
  // When present, the in-transit card computes real progress (km covered
  // from actual GPS fixes vs. km remaining). When absent, the card shows
  // only elapsed time and last known position - never a fabricated ETA.
  expectedDistanceKm       Decimal?           @map("expected_distance_km") @db.Decimal(7, 1)
  /// Set together, only when an OWNER overrides a driver-category/vehicle-type
  /// mismatch at creation. Null on every ordinary (compatible) job.
  categoryOverrideReason   String?            @map("category_override_reason")
  categoryOverrideByUserId String?            @map("category_override_by_user_id")
  categoryOverrideAt       DateTime?          @map("category_override_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  expenses Expense[]

  @@index([tenantId])
  @@index([motorcycleId])
  @@map("transport_jobs")
}

enum OwnershipPlanStatus {
  ACTIVE // generating daily instalments
  COMPLETED // fully paid, the vehicle is the driver's
  DEFAULTED // owner gave up on it
  CANCELLED // called off, e.g. entered by mistake

  @@map("ownership_plan_status")
}

/// Stage G10 (§9e) - how a plan's down payment is treated on creation.
enum DepositHandling {
  APPLIED // down payment applied to the schedule like any payment
  HELD_REFUNDABLE // owner keeps it separately; returned at completion

  @@map("deposit_handling")
}

/// A rent-to-own contract: the driver pays dailyAmount against a
/// DailyAssignment generated for them each active weekday (see the nightly
/// generator, a later stage) until totalPrice - downPayment is paid off.
/// Deliberately no balance/position columns here - everything is derived from
/// the plan's assignments and payments (see ownership-plan.derivation.ts).
///
/// tenantId/driverId/motorcycleId are plain scalars, not Prisma relations,
/// matching DESIGN_HIRE_PURCHASE.md §3 exactly - existence and ownership are
/// checked in the service layer instead.
///
/// A vehicle may be on at most one ACTIVE plan. Prisma cannot express a
/// partial unique index, so it is created as raw SQL in this model's
/// migration (WHERE status = 'ACTIVE') - the next person should not assume
/// the schema is the whole story here. Enforced again in the service layer
/// with a clear error message; the index is the backstop, not the check.
model OwnershipPlan {
  id           String  @id @default(cuid())
  tenantId     String  @map("tenant_id")
  driverId     String  @map("driver_id") // the buyer
  motorcycleId String  @map("motorcycle_id") // the vehicle being bought
  // Stage G Part 3: the guarantor this specific plan's contract names as
  // next of kin. Nullable, and a plain scalar like tenantId/driverId/
  // motorcycleId above (DESIGN_HIRE_PURCHASE.md §3) - existence, same-tenant,
  // and same-driver are all checked in the service layer, not by a Prisma
  // relation. Before this, the contract picked "the driver's most recently
  // added active guarantor" implicitly (see ownership-plan-contract.service.ts);
  // an explicit guarantorId here is what the owner actually chooses at plan
  // creation. A driver may still have several guarantors - this is which one
  // this plan's contract prints, nothing more.
  guarantorId  String? @map("guarantor_id")

  dailyAmount     Decimal @map("daily_amount") @db.Decimal(10, 2) // e.g. 12000.00
  // Stage G7 - the agreed number of payment days, negotiated directly between
  // owner and driver alongside dailyAmount. totalOwed = dailyAmount *
  // instalmentCount, exactly, always - see ownership-plan.derivation.ts. This
  // replaced totalOwed = totalPrice - downPayment, which forced a division by
  // dailyAmount that only sometimes came out even.
  instalmentCount Int     @map("instalment_count")
  // Declared value of the vehicle and the deposit taken - printed on the
  // contract, but (Stage G7) no longer used to derive totalOwed or anything
  // else arithmetic. May legitimately differ from dailyAmount * instalmentCount.
  totalPrice      Decimal @map("total_price") @db.Decimal(12, 2)
  downPayment     Decimal @default(0) @map("down_payment") @db.Decimal(12, 2)

  startDate       DateTime  @map("start_date") @db.Date // contract begins
  // Stage BI1 - startDate used to do two jobs: the true historical date
  // printed on the contract (ownership-plan-contract.pdf.ts/.service.ts -
  // leave those reading startDate, never this) AND the anchor every
  // schedule-projection read (derivedEndDate/daysLeft/projectedCompletion/
  // nextDueDate in ownership-plan.derivation.ts, and the generator's own
  // backfill-start fallback) walked forward from. Fine for an ordinary plan,
  // where the two dates are the same day - wrong for an imported plan, whose
  // real startDate can be months in the past: the projection math would walk
  // forward from that historical date and show an already-elapsed derived
  // end date. Nullable, null for every ordinary plan (?? startDate is then a
  // no-op); the bulk importer is the only writer that ever sets it, to the
  // date digital billing actually begins.
  billingStartDate DateTime? @map("billing_start_date") @db.Date
  contractEndDate DateTime? @map("contract_end_date") @db.Date // agreed end, see §5
  // All seven days, matching "siku ... mfululizo" (consecutive calendar days,
  // no weekend exclusion) in the real contract - Mon-Sat-only was a wrong
  // assumption in an earlier stage. Existing rows are NOT migrated: this
  // changes only what NEW plans get, on purpose (see Stage F2 Part 1).
  activeWeekdays  Int[]     @default([0, 1, 2, 3, 4, 5, 6]) @map("active_weekdays") // 0=Sun..6=Sat
  graceDays       Int       @default(0) @map("grace_days")

  // Printed terms only (Stage F2 Part 3) - never read by derivation.ts or by
  // payment.service.ts's overpayment guard. A penalty a driver owes is never
  // money that moves them closer to owning the vehicle, so this must never
  // join totalOwed/amountBilled/amountPaid/remainingToBill/remainingToOwn/
  // remainingUnreserved. The owner collects it by hand.
  lateFeeAmount                    Decimal? @map("late_fee_amount") @db.Decimal(10, 2)
  breachAfterConsecutiveMissedDays Int      @default(5) @map("breach_after_consecutive_missed_days")

  // Completion checklist - set later, by hand, once the plan is fully paid.
  // Not read by the contract renderer (all null at contract-generation time);
  // reserved for a future dashboard/API to mark handover done.
  registrationCardHandedOverAt DateTime? @map("registration_card_handed_over_at")
  spareKeyHandedOverAt         DateTime? @map("spare_key_handed_over_at")
  nameTransferConfirmedAt      DateTime? @map("name_transfer_confirmed_at")

  // Stage G10 (§9e) - how the down payment is treated. APPLIED (default)
  // credits it toward the schedule like any other payment - see
  // OwnershipPlanService.create()'s eager first-instalment allocation.
  // HELD_REFUNDABLE means the owner keeps it separately, untouched by
  // totalOwed/amountPaid/remainingToOwn, returned at completion -
  // depositReturnedAt is that checklist item, alongside the three above,
  // and (like them) is never read by the contract renderer or derivation.ts.
  depositHandling   DepositHandling @default(APPLIED) @map("deposit_handling")
  depositReturnedAt DateTime?       @map("deposit_returned_at")

  status      OwnershipPlanStatus @default(ACTIVE)
  completedAt DateTime?           @map("completed_at")
  defaultedAt DateTime?           @map("defaulted_at")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, driverId])
  @@map("ownership_plans")
}

enum DayExcusalStatus {
  REQUESTED
  APPROVED
  DECLINED

  @@map("day_excusal_status")
}

/// Stage G4 - Clause 2 fines a driver only when he has NOT told his
/// supervisor the reason for a missed day; a phoned-in funeral or sick
/// relative was never meant to read the same as a driver who vanished. This
/// is what lets computeConsecutiveMissedDays (ownership-plan.derivation.ts)
/// tell the two apart.
///
/// Keyed on (ownershipPlanId, excusedDate), NOT dailyAssignmentId - a driver,
/// or staff on his behalf, can give notice for a day before the nightly
/// generator has created that day's assignment row. ownershipPlanId is a
/// plain scalar, matching DailyAssignment's own reference to a plan (see
/// that model's comment) - existence and same-tenant are checked in the
/// service layer.
///
/// Modelled as a request with a status, not a flag, because the driver app
/// will eventually create these itself (REQUESTED, requestedByUserId set,
/// no immediate decision) - NOT built in this stage, but the model must not
/// need to change when it is. Staff-created excusals are APPROVED
/// immediately (decidedByUserId/decidedAt set at creation).
///
/// Prisma cannot express a partial unique index ("at most one APPROVED row
/// per date"), so this deliberately allows multiple rows for the same date.
/// computeConsecutiveMissedDays treats ANY APPROVED row for a date as
/// excusing it - REQUESTED and DECLINED rows are never read for that
/// purpose. An excusal changes the judgement signal only: it must never be
/// joined into totalOwed/amountBilled/amountPaid/remainingToBill/
/// remainingToOwn, the same rule DESIGN_HIRE_PURCHASE.md §9c gives the late
/// fine - the charge still stands and the driver still owes it.
model DayExcusal {
  id                String           @id @default(cuid())
  tenantId          String           @map("tenant_id")
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  ownershipPlanId   String           @map("ownership_plan_id")
  excusedDate       DateTime         @map("excused_date") @db.Date
  reason            String
  status            DayExcusalStatus @default(REQUESTED)
  /// Null when staff-created (an OWNER/MANAGER typing this in on the
  /// driver's behalf) - set once the driver app can create these itself.
  requestedByUserId String?          @map("requested_by_user_id")
  decidedByUserId   String?          @map("decided_by_user_id")
  decidedAt         DateTime?        @map("decided_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([tenantId, ownershipPlanId, excusedDate])
  @@map("day_excusals")
}

enum PaymentAccountKind {
  BANK
  LIPA_NUMBER
  MOBILE_MONEY

  @@map("payment_account_kind")
}

/// A destination a driver can pay into - printed on the hire-purchase
/// contract's daily-obligation term (§Part 3) and optionally attached to a
/// DailyPayment when a driver names which one they used. tenantId is a plain
/// scalar relation like the rest of this file's tenant-scoped models.
model PaymentAccount {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  kind          PaymentAccountKind
  /// The name a driver recognises: "NMB", "Azam Pesa", "M-Pesa", "CRDB".
  provider      String
  /// Bank account no. / till number / phone number, depending on kind.
  accountNumber String             @map("account_number")
  /// The name on a bank account. Optional for LIPA_NUMBER/MOBILE_MONEY.
  accountName   String?            @map("account_name")
  isActive      Boolean            @default(true) @map("is_active")
  sortOrder     Int                @default(0) @map("sort_order")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  payments DailyPayment[]

  @@index([tenantId, isActive, sortOrder])
  @@map("payment_accounts")
}

/// How a password reset was initiated. One reset service serves all of these;
/// this records which door it came through.
enum PasswordResetRoute {
  /// An owner set it from the dashboard, on the rider's behalf.
  OWNER_DASHBOARD
  /// The user proved control of a contact channel with a one-time code.
  SELF_SERVICE_CODE

  @@map("password_reset_route")
}

/// Where a self-service code was delivered. Null for OWNER_DASHBOARD, which
/// delivers nothing. SMS exists here before it is implemented on purpose:
/// adding it is a second sender for the same flow, not a second flow, and
/// having the value present keeps that visible.
enum PasswordResetChannel {
  EMAIL
  SMS

  @@map("password_reset_channel")
}

/// One row per completed password reset - who was reset, who did it, and by
/// which route. Written inside the same transaction as the password change,
/// so a reset can never happen without a record of it.
///
/// Deliberately holds plain ids rather than relations: an audit row has to
/// outlive the user it describes, and a foreign key with a cascade would
/// delete exactly the evidence you would want after an account is removed.
model PasswordResetAudit {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// The account whose password changed.
  userId String @map("user_id")

  /// Who performed it. Null for SELF_SERVICE_CODE - the user is the actor,
  /// and recording them twice would imply an approval that never happened.
  actorUserId String? @map("actor_user_id")

  route   PasswordResetRoute
  channel PasswordResetChannel?

  /// How many refresh tokens were destroyed. A reset that revokes nothing
  /// means the account had no live session; a reset that revokes several
  /// means the rider was signed in somewhere, which is what you want to see
  /// when a device is reported lost.
  sessionsRevoked Int @default(0) @map("sessions_revoked")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("password_reset_audits")
}

/// Stage SUB1 (DESIGN_SUBSCRIPTION.md §5b). BongoFleet's OWN platform pricing
/// for what it charges a tenant to run its fleet through this product - not
/// tenant-scoped data, deliberately no tenantId, unlike everything else in
/// this file. Excluded from the tenant-scoping Prisma extension for exactly
/// that reason (see tenant-scoping.extension.ts's EXCLUDED_MODELS) - it has
/// no tenantId column for that extension's implicit `where` to attach to.
///
/// Shaped as a tiered table from day one, even though v1 seeds exactly one
/// row, because §5b's documented future direction is a 4-row table
/// (0/11/31/51 bikes -> 10k/9k/8k/7k per bike) and that must be an INSERT
/// against this shape, not a schema change. There is no platform-admin role
/// in this codebase (UserRole is OWNER/MANAGER/RIDER/MECHANIC only) - so for
/// now, changing or adding a row here is a migration, not a dashboard
/// action. See resolvePricingTier (subscription-pricing.ts) for how a row is
/// chosen for a given bike count.
model SubscriptionPricingTier {
  id String @id @default(cuid())

  /// The lowest active-bike count this tier applies to. 0 = the base tier -
  /// resolvePricingTier requires exactly one row with minBikeCount 0 to
  /// exist as the floor every bike count resolves against.
  minBikeCount Int @default(0) @map("min_bike_count")

  pricePerBikePerMonth Decimal @db.Decimal(10, 2) @map("price_per_bike_per_month")

  /// When this tier took effect - lets a future rate change apply only going
  /// forward without touching history. Nothing reads historical bills
  /// against this yet (nothing bills at all yet - actual charge collection
  /// is still blocked on AzamPay, §8 step 4), but the field earns its keep
  /// the day that ships.
  effectiveFrom DateTime @default(now()) @map("effective_from")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscription_pricing_tiers")
}

/// Stage I2 (DESIGN_GPS_TRACKING.md §8) - a "no login required" shareable
/// link: an owner checking one vehicle from a phone, or handing a customer
/// a link to watch a truck carrying their cargo. Tenant-scoped (has
/// tenantId, unlike SubscriptionPricingTier above) even though the public
/// lookup (TrackingLinkPublicController) resolves it with NO request
/// context at all - that controller wraps its Prisma calls in
/// requestContext.runUnscoped() and filters by tenantId explicitly itself,
/// the same technique this codebase's test utilities use outside a request.
///
/// motorcycleId null means "whole fleet" - onDelete: Restrict on the
/// relation (like every other Motorcycle reference in this file) so a link
/// can never end up pointing at a vanished vehicle; the referenced
/// motorcycle must be deactivated (isActive: false), never hard-deleted,
/// while a link still names it.
model TrackingLink {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  motorcycleId String?     @map("motorcycle_id")
  motorcycle   Motorcycle? @relation(fields: [motorcycleId], references: [id], onDelete: Restrict)

  /// crypto.randomBytes(32).toString('base64url') - see tracking-token.util.ts.
  /// 32+ bytes of CSPRNG output is the actual security boundary on the public
  /// endpoint (there is no auth on it at all); PUBLIC_TRACK_IP_THROTTLE is
  /// abuse hygiene on top of that, not a substitute for it.
  token String @unique

  /// What the OWNER/MANAGER who created this link called it, e.g. "Truck
  /// T203 - Mombasa delivery". Shown nowhere on the public view itself
  /// (§8's whitelist excludes it), only in the dashboard's own list.
  label String

  /// Nullable, but never actually null on a freshly created link - the
  /// service defaults this to now() + 7 days server-side when the caller
  /// omits it (§8: "should default to an expiry date rather than never").
  /// Only reachable by passing expiresAt: null EXPLICITLY in the create
  /// request - the one deliberate way to make a link that never expires.
  expiresAt DateTime? @map("expires_at")

  /// Null = still live. Set once, never cleared - revoking is one-way; a
  /// mistakenly revoked link is recreated, not un-revoked. PATCH
  /// .../revoke is idempotent BECAUSE of that: calling it again on an
  /// already-revoked link just returns the existing revokedAt, never a
  /// second write or an error.
  revokedAt DateTime? @map("revoked_at")

  createdByUserId String @map("created_by_user_id")

  /// Incremented on every successful public GET, regardless of whether the
  /// caller is the owner refreshing their own link or a customer - this is
  /// a raw hit counter, not a unique-visitor count.
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("tracking_links")
}
