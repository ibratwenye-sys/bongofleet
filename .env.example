# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (Postgres, matches docker-compose.yml) ---
# Default host port is 5433, not Postgres's usual 5432 - a native Windows
# PostgreSQL install commonly already owns 5432 and silently intercepts
# connections meant for this container, causing confusing auth failures.
DB_HOST=localhost
DB_PORT=5433
DB_USER=bongofleet
DB_PASSWORD=bongofleet_dev_password
DB_NAME=bongofleet
DATABASE_URL=postgresql://bongofleet:bongofleet_dev_password@localhost:5433/bongofleet

# Postgres connection pool (pg.PoolConfig, via @prisma/adapter-pg). These
# defaults are starting points, not numbers verified against a real
# production Postgres instance under load - tune both once there's real
# traffic to size them against.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# e2e tests run against a SEPARATE database so they never wipe your dev data.
# Leave this unset to auto-use "<db>_test" (e.g. bongofleet_test); the test
# runner creates and migrates it automatically. Only set it to override, and it
# MUST name a *_test database - the runner refuses anything else.
# TEST_DATABASE_URL=postgresql://bongofleet:bongofleet_dev_password@localhost:5433/bongofleet_test

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# e2e tests run against a SEPARATE Redis database (index), so they never
# share a keyspace with your dev sessions/throttle counters - same reasoning
# as TEST_DATABASE_URL above (Stage H0c). Leave this unset to auto-use db 15
# on the same REDIS_URL host/port; the test runner refuses to start if that
# would resolve to the same host+port+db dev uses. Only set it to override.
# TEST_REDIS_URL=redis://localhost:6379/15

# --- pgAdmin (docker-compose only, not used by the app) ---
PGADMIN_EMAIL=admin@bongofleet.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Auth ---
JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated allowlist of origins allowed to call the API with credentials.
# Required in production (the app refuses to start without it there). Left unset
# in development, it falls back to the local dashboard/mobile dev origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# --- Trust proxy (Stage H0b) ---
# Controls what req.ip means, which every anonymous rate limit is keyed on
# (see throttler-options.factory.ts). Left "0"/empty (the default) here for
# local dev, where there is no reverse proxy in front.
#
# In production behind nginx/Caddy/a load balancer (the Hetzner deployment
# plan), set this to "1" - exactly one trusted hop, so req.ip resolves to the
# real client address the proxy forwarded, not the proxy's own. NEVER set
# this to "true": that accepts any client-supplied X-Forwarded-For at face
# value, letting a client pick its own rate-limit identity. A specific proxy
# address/subnet (e.g. "10.0.0.5") is also accepted in place of a hop count.
# Any other value refuses to start rather than silently defaulting to
# something permissive - see trust-proxy.util.ts.
TRUST_PROXY=0

# --- Payments (placeholders - fill in when payments milestone starts) ---
# e.g. mobile money provider keys go here once that integration is scoped

# --- Outgoing email (document expiry alerts) ---
# Leave SMTP_HOST blank for "log-only" mode: alert emails are written to the
# app log instead of sent - safe for development. For real email, point these
# at any SMTP relay (SES, Mailgun, Zoho, Gmail app password, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BongoFleet <no-reply@bongofleet.app>

# --- Document expiry scan ---
# Daily digest of expired / expiring-soon documents, one email per fleet.
DOCUMENT_EXPIRY_ALERT_DAYS=30
DOCUMENT_EXPIRY_CRON=0 7 * * *
DOCUMENT_EXPIRY_TZ=Africa/Dar_es_Salaam

# --- Missed-payment scan ---
# Daily digest of past assignments where the driver paid nothing or under
# target, one email per fleet. Shares DOCUMENT_EXPIRY_TZ for its timezone.
MISSED_PAYMENT_CRON=30 7 * * *
MISSED_PAYMENT_LOOKBACK_DAYS=7

# --- Maintenance reminder scan ---
# Daily digest of motorcycles due/overdue for service, one email per fleet.
# DUE_SOON fires within DAYS of the next-service date, or within MILEAGE km of
# the next-service odometer target. Shares DOCUMENT_EXPIRY_TZ for its timezone.
MAINTENANCE_REMINDER_CRON=0 8 * * *
MAINTENANCE_REMINDER_DAYS=14
MAINTENANCE_REMINDER_MILEAGE=500

# --- GPS "offline vehicle" health alert (DESIGN_GPS_TRACKING.md §6) ---
# Daily digest of box/phone-tracked vehicles that have gone stale (no fix
# within GPS_STALE_AFTER_MINUTES), one email per fleet. A vehicle that has
# never reported a single fix, or whose trackingMode is NONE, never alerts.
# Shares DOCUMENT_EXPIRY_TZ for its timezone.
GPS_OFFLINE_ALERT_CRON=0 8 * * *

# --- API docs (Swagger/OpenAPI) ---
# Off in production unless explicitly set true - same fail-safe-by-default
# pattern as CORS_ORIGINS. Always on in development regardless of this value.
SWAGGER_ENABLED=false

# --- File uploads (driver/motorcycle/guarantor documents) ---
# Directory uploaded files are written to. In docker-compose this is a named
# volume mounted at /workspace/uploads so files survive container restarts;
# locally it defaults to ./uploads under packages/backend (gitignored).
UPLOADS_DIR=./uploads

# --- Stage 1b: credentials-at-rest encryption ---
# Required. Base64-encoded 32 raw bytes - the AES-256-GCM key
# credentials-encryption.ts uses to encrypt GpsProviderConfig.
# credentialsEncrypted (and, later, Stage J's PaymentGatewayConfig). Fails
# loudly on first use if missing or not exactly 32 bytes once decoded -
# never a silent default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- GPS box-ingestion polling ---
# How often GpsDevicePollingService polls each active GpsProviderConfig's
# Traccar server for device positions. Builds a "*/N * * * *" cron
# expression, so this must be an integer between 1 and 60.
GPS_DEVICE_POLL_INTERVAL_MINUTES=3
